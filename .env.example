# Postgres. Bun's native client; no native addons.
DATABASE_URL=postgres://d1sks:d1sks@localhost:5443/d1sks
# Public origin, no trailing slash.
SITE_URL=http://localhost:3000
# web, worker, or both. The worker refetches every listed descriptor hourly.
ROLES=web,worker
PORT=3000
# Minutes between poller passes; each pass refetches disks older than an hour.
POLL_MINUTES=15
